{
  "name": "mini-qlab",
  "version": "2.2.1",
  "type": "module",
  "description": "Browser-based cue-list controller for React - DECADE.TW",
  "files": [
    "dist"
  ],
  "main": "./dist-npm/mini-qlab.js",
  "module": "./dist-npm/mini-qlab.js",
  "exports": {
    ".": "./dist-npm/mini-qlab.js",
    "./styles.css": "./dist-npm/style.css"
  },
  "homepage": "https://decade.tw/qlab",
  "repository": {
    "type": "git",
    "url": "https://github.com/xlinx/DECADE.TW_Mini_QLab.git"
  },
  "private": false,
  "author": "YSLin <xlinx@decade.tw>",
  "contributors": [
    {
      "name": "YSLin",
      "email": "xlinx@decade.tw"
    }
  ],
  "license": "MIT",
  "keywords": [
    "qlab",
    "timeline",
    "cue",
    "dmx"
  ],


  "scripts": {
    "global_pnpm": "rm -rf node_modules .pnpm && pnpm config set virtualStoreType global --location global && pnpm install",

    "dev": "vite",
    "build": "vite build",
    "build:electron": "vite build --mode electron",
    "build:web": "vite build --mode web",
    "build:npm": "vite build --mode npm",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "vite build --mode electron && electron-builder --mac",
    "electron:pack": "vite build --mode electron && electron-builder --mac --dir",
    "electron:build:mac": "vite build --mode electron && electron-builder --mac",
    "electron:build:win": "vite build --mode electron && electron-builder --win",
    "electron:build:linux": "vite build --mode electron && electron-builder --linux",
    "electron:build:all": "vite build --mode electron && electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "tw.decade.miniqlab",
    "productName": "Mini QLab",
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "dist-app/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Video"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "cron-parser": "^5.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^3.4.17",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  }
}
